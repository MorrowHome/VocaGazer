# SQLite（与 prisma/schema.prisma 一致）
DATABASE_URL="file:./prisma/dev.db"

# 应用 URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT（生产环境必须设置，至少 16 位随机字符串）
JWT_SECRET="change-me-in-production-use-a-long-random-string"

# 手动触发采集接口 /api/crawl/trigger 的密钥
# curl -H "x-cron-secret: 你的密钥" https://你的域名/api/crawl/trigger?type=ranking
CRON_SECRET="change-me-cron-secret"

# AI 分析（DeepSeek 兼容 Anthropic SDK；不配则使用模板晚报）
# ANTHROPIC_API_KEY="sk-..."
# ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
# AI_MODEL="deepseek-v4-flash"
